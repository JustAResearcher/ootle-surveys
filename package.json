{
  "name": "ootle-surveys",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node --experimental-wasm-modules --import tsx server/index.ts",
    "setup:testnet": "node --experimental-wasm-modules --import tsx scripts/setup.ts",
    "verify:testnet": "node --experimental-wasm-modules --import tsx scripts/verify.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@tari-project/ootle": "0.5.0",
    "@tari-project/ootle-indexer": "0.5.0",
    "@tari-project/ootle-secret-key-wallet": "0.5.0",
    "@tari-project/ootle-ts-bindings": "^1.53.0",
    "@tari-project/ootle-wasm": "0.41.1",
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.8",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-wasm": "^3.5.0"
  }
